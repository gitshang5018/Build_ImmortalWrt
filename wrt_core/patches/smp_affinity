#!/bin/sh /etc/rc.common
######################################################################
# vim: set ft=bash
# shellcheck disable=2155,3019,3043,3057,3060
######################################################################

START=93

PROG=smp_affinity

# 路径可注入, 便于单元测试在假 /proc 下验证绑核逻辑
INTERRUPTS_FILE="${INTERRUPTS_FILE:-/proc/interrupts}"
PROC_IRQ_DIR="${PROC_IRQ_DIR:-/proc/irq}"

log_msg() {

    local irq_name="$1" affinity="$2" irq="$3"

    msg="$(printf "Pinning IRQ($irq) %-24s to CPU ${affinity}\n" "$irq_name")"

    logger -t "$PROG" "$msg"
}

######################################################################
### Takes a comma, space separated, or range list of CPU numbers and
## returns a bitmask of CPUs.
## cpus_to_bitmask "0,1,2,3" -> f
## cpus_to_bitmask "0 1 2 3" -> f
## cpus_to_bitmask "0-3"     -> f
## cpus_to_bitmask "3"       -> 8
#######################################################################

cpus_to_bitmask() {

    local bitmask=0
    # shellcheck disable=2048
    for range in ${*//,/ }; do
        start="${range%-*}"
        end="${range#*-}"
        if [ -z "$end" ]; then
            bitmask="$((bitmask | 1 << start))"
        else
            bitmask="$((bitmask | ((1 << (end - start + 1)) - 1) << start))"
        fi
    done
    printf '%x' $bitmask
}

######################################################################
### Takes a bitmask of CPUs and returns a space separated list of
## CPU numbers.
## bitmask_to_cpus f -> 0 1 2 3
######################################################################

bitmask_to_cpus() {

    [ "${1:0:2}" != "0x" ] && set -- "0x$1"
    local bitmask="$(printf '%d' "$1")"

    local cpus=""
    for i in $(seq 0 63); do
        if [ $((bitmask & 1)) -ne 0 ]; then
            cpus="$cpus $i"
        fi
        bitmask=$((bitmask >> 1))
    done
    echo "${cpus# }"
}

######################################################################
### Sets the affinity of the IRQs with the given name to the given CPU.
## 1st argument: IRQ name ("reo2host-destination-ring1") (req)
## 2nd argument: CPU number (req)
######################################################################

set_affinity() {
    local irq_name="$1" affinity="$2" occurrence="${3:-1}" bitmask irq
    awk -v irq_name="$1" -v occurrence="$occurrence" '
        BEGIN{count=0}
        $NF==irq_name {
            if(++count==occurrence){
                sub(/:$/,"",$1)
                print $1
            }
        }' "$INTERRUPTS_FILE" | while read -r irq; do
        $enable_log && {
            log_msg "$irq_name" "$affinity" "$irq"
        }
        bitmask=$(cpus_to_bitmask "$affinity") && echo "$bitmask" >"$PROC_IRQ_DIR/$irq/smp_affinity"
    done
}

set_affinity_pattern() {
    local pattern="$1" affinity="$2" bitmask irq name
    awk -v pat="$pattern" '
        $0 ~ pat {
            sub(/:$/,"",$1)
            print $1, $NF
        }' "$INTERRUPTS_FILE" 2>/dev/null | while read -r irq name; do
        $enable_log && {
            log_msg "$name" "$affinity" "$irq"
        }
        bitmask=$(cpus_to_bitmask "$affinity") && echo "$bitmask" >"$PROC_IRQ_DIR/$irq/smp_affinity" 2>/dev/null
    done
}

######################################################################
### 将匹配到的多个中断向量按顺序轮流绑定到给定 CPU 列表.
## 用于多 MSI-X 向量的 PCIe 无线网卡: 单纯写多核掩码时, GIC 仍会把
## 中断固定投递到掩码内的第一个核, 只有把不同向量分到不同核才真正并行.
## 1st argument: 中断名匹配模式 (req)
## 2nd argument: CPU 列表, 空格分隔 ("0 1") (req)
######################################################################

set_affinity_alternate() {
    local pattern="$1" cpus="$2" bitmask irq name cpu idx=0
    awk -v pat="$pattern" '
        $0 ~ pat {
            sub(/:$/,"",$1)
            print $1, $NF
        }' "$INTERRUPTS_FILE" 2>/dev/null | while read -r irq name; do
        cpu=$(echo "$cpus" | awk -v i="$idx" '{n = split($0, a, " "); print a[(i % n) + 1]}')
        idx=$((idx + 1))
        $enable_log && {
            log_msg "$name" "$cpu" "$irq"
        }
        bitmask=$(cpus_to_bitmask "$cpu") && echo "$bitmask" >"$PROC_IRQ_DIR/$irq/smp_affinity" 2>/dev/null
    done
}

enable_affinity() {
    # 1. 外挂 PCIe 无线网卡 (AX6600 雅典娜 QCN9074 5.2G 160MHz) 绑定到 CPU 0-1:
    # QCN9074 走 PCIe 路径, NSS 卸载的代码只在 AHB 路径, 4x4 HE160 的收包完全由 CPU 处理;
    # 先把向量池兜底在 0-1, 再按 MSI-X 向量逐个交替分配, 让数据面真正并行到两个核,
    # 同时避开 CPU 2-3 上的有线 EDMA 与 nss_queue 队列.
    set_affinity_pattern 'pci-msi.*ath11k' '0-1'
    set_affinity_alternate 'ath11k_pci' '0 1'

    # 2. 均衡分配有线网络 (EDMA) 中断到不同 CPU, 避免集中在 CPU 3 造成单核热点打满:
    # 将高频 hot path 的接收 (rxdesc) 与发送 (txcmpl) 彻底解耦到不同 CPU
    set_affinity 'edma_rxdesc' 1 1
    set_affinity 'edma_txcmpl' 2 1
    set_affinity 'edma_rxfill' 3 1
    set_affinity 'edma_misc' 3 1

    # 3. NSS 队列 nss_queue0 分配给 CPU 2-3
    set_affinity 'nss_queue0' 2-3 1

    # 4. Copy Engine DMA 均匀分布
    set_affinity 'bam_dma' 1 1
    set_affinity 'bam_dma' 2 2
    set_affinity 'bam_dma' 3 3
}

configure_edma_offloads() {
    local dev dev_path

    command -v ethtool >/dev/null 2>&1 || return
    for dev_path in /sys/class/net/eth*; do
        [ -e "$dev_path" ] || continue
        dev="${dev_path##*/}"
        ethtool -K "$dev" gro on >/dev/null 2>&1
        ethtool -K "$dev" rx on >/dev/null 2>&1
        ethtool -K "$dev" tx on >/dev/null 2>&1
    done
}

boot() {

    local enable

    config_load smp_affinity

    config_get_bool enable "general" enable 1
    config_get_bool enable_log "general" enable_log 1

    [ "$enable" -eq 1 ] && enable=true || enable=false
    [ "$enable_log" -eq 1 ] && enable_log=true || enable_log=false

    if $enable; then
        enable_affinity
        configure_edma_offloads
    fi
}
