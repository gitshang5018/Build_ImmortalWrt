# NSS (NSS 12.5 via qosmio/qca-sdk-nss-fw, NSS_PROFILE=R retail, no per-SoC DDR size profile)
# Removed legacy symbols IPQ_MEM_PROFILE_256 / ATH11K_MEM_PROFILE_512M / NSS_MEM_PROFILE_MEDIUM
# / NSS_FIRMWARE_VERSION_11_4 — none are defined in the current qca-nss-* Config.in and are
# silently ignored by kconfig; upstream firmware is now 12.5 retail (retail_router0.bin).
CONFIG_PACKAGE_sqm-scripts-nss=y
CONFIG_PACKAGE_kmod-qca-mcs=y
CONFIG_KERNEL_SKB_RECYCLER=y
CONFIG_KERNEL_SKB_RECYCLER_MULTI_CPU=y
CONFIG_PACKAGE_kmod-ath11k=y
CONFIG_PACKAGE_kmod-ath11k-ahb=y
CONFIG_PACKAGE_kmod-ath11k-pci=y
CONFIG_PACKAGE_ath11k-firmware-ipq6018-ddwrt=y
CONFIG_PACKAGE_ath11k-firmware-qcn9074-ddwrt=y

#  NSS kernel drive
CONFIG_PACKAGE_kmod-qca-nss-drv-igs=y
CONFIG_PACKAGE_kmod-qca-nss-drv-l2tpv2=y
CONFIG_PACKAGE_kmod-qca-nss-drv-lag-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-pppoe=y
CONFIG_PACKAGE_kmod-qca-nss-drv-pptp=y
CONFIG_PACKAGE_kmod-qca-nss-drv-bridge-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-vlan=y
CONFIG_PACKAGE_kmod-qca-nss-drv-qdisc=y
