#!/bin/sh /etc/rc.common
# Copyright (C) 2026 AeroWrt Developers

USE_PROCD=1
START=95
STOP=10

PROG=/usr/bin/aerowrt
CONF="aerowrt"

start_service() {
	config_load "$CONF"
	local enabled port mosdns_port

	config_get_bool enabled "main" "enabled" 1
	config_get port "main" "port" 9099
	config_get mosdns_port "main" "mosdns_port" 5335

	[ "$enabled" -eq 1 ] || return 0

	[ -x "$PROG" ] || {
		logger -t aerowrt "Error: $PROG is not executable or not found"
		return 1
	}

	mkdir -p /etc/aerowrt

	# 确保杀掉可能残留的孤儿进程，避免 9099 端口占用导致启动失败
	killall aerowrt 2>/dev/null || true

	procd_open_instance
	procd_set_param command "$PROG" -port "$port" -mosdns "$mosdns_port"
	procd_set_param env GOMEMLIMIT=20MiB GODEBUG=madvdontneed=1
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	killall aerowrt 2>/dev/null || true
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger "aerowrt"
}


