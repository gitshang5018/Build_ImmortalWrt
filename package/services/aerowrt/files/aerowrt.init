#!/bin/sh /etc/rc.common
# Copyright (C) 2026 AeroWrt Developers

USE_PROCD=1
START=95
STOP=10

PROG=/usr/bin/aerowrt
CONF="aerowrt"

start_service() {
	config_load "$CONF"
	local enabled port mosdns_port

	config_get_bool enabled "main" "enabled" 1
	config_get port "main" "port" 9099
	config_get mosdns_port "main" "mosdns_port" 5335

	[ "$enabled" -eq 1 ] || return 0

	[ -x "$PROG" ] || {
		logger -t aerowrt "Error: $PROG is not executable or not found"
		echo "Error: $PROG is not executable or not found" >&2
		return 1
	}

	mkdir -p /etc/aerowrt

	# 确保 /dev/net/tun 字符设备与 tun 模块就绪
	[ -c /dev/net/tun ] || {
		mkdir -p /dev/net
		mknod /dev/net/tun c 10 200 2>/dev/null || true
		modprobe tun 2>/dev/null || true
	}

	# 确保 OpenWrt 防火墙允许 WAN 入站访问 AeroWrt 控制台端口
	uci -q get firewall.aerowrt_wan >/dev/null || {
		uci set firewall.aerowrt_wan=rule
		uci set firewall.aerowrt_wan.name="AeroWrt-WAN"
		uci set firewall.aerowrt_wan.src="wan"
		uci set firewall.aerowrt_wan.dest_port="$port"
		uci set firewall.aerowrt_wan.proto="tcp"
		uci set firewall.aerowrt_wan.target="ACCEPT"
		uci commit firewall
		/etc/init.d/firewall reload 2>/dev/null || true
	}

	# 确保系统启用宽松反向路径过滤 (Loose rp_filter = 2)，防止 Sing-box TUN 路由导致 WAN 入站流量被内核丢弃
	sysctl -w net.ipv4.conf.all.rp_filter=2 >/dev/null 2>&1 || true
	sysctl -w net.ipv4.conf.default.rp_filter=2 >/dev/null 2>&1 || true
	for f in /proc/sys/net/ipv4/conf/*/rp_filter; do
		echo 2 > "$f" 2>/dev/null || true
	done

	procd_open_instance
	procd_set_param command "$PROG" -port "$port" -mosdns "$mosdns_port"
	procd_set_param env ENABLE_DEPRECATED_LEGACY_DNS_SERVERS=true ENABLE_DEPRECATED_SPECIAL_OUTBOUNDS=true ENABLE_DEPRECATED_LEGACY_INBOUND_OPTIONS=true ENABLE_DEPRECATED_MISSING_DOMAIN_RESOLVER=true
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	# 发送 SIGTERM 给 aerowrt 主进程，由其内部优雅关闭 sing-box 核心进程
	killall -15 aerowrt 2>/dev/null || true
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger "aerowrt"
}


