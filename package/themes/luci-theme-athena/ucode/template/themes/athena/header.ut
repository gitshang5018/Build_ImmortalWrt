{%
	import { getuid, getspnam } from 'luci.cbi';
	import { readfile } from 'fs';

	let node = menu.get_active_node();
	let categories = menu.get_categories();
	let hostname = uci.get('system', '@system[0]', 'hostname') || 'ImmortalWrt';

	http.prepare_content('text/html; charset=UTF-8');
-%}
<!DOCTYPE html>
<html lang="{{ dispatcher.lang }}" data-theme="light">
<head>
	<meta charset="utf-8">
	<title>{{ striptags(`${hostname}${node?.title ? ` - ${node.title}` : ''}`) }} - LuCI</title>
	<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
	<meta name="theme-color" content="#1E88E5">
	<meta name="apple-mobile-web-app-capable" content="yes">
	<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
	<link rel="stylesheet" href="{{ media }}/css/cascade.css">
	<link rel="stylesheet" href="{{ media }}/css/dark.css">
	<link rel="stylesheet" href="{{ media }}/css/mobile.css">
	<link rel="shortcut icon" href="{{ media }}/img/logo.svg" type="image/svg+xml">
	<script src="{{ dispatcher.build_url('admin/translations', dispatcher.lang) }}"></script>
	<script src="{{ resource }}/cbi.js"></script>
	<script src="{{ resource }}/luci.js"></script>
	<script src="{{ media }}/js/theme.js"></script>
</head>
<body class="lang_{{ dispatcher.lang }} {{ entityencode(node?.name ?? '', true) }}">
	<div id="athena-backdrop" class="athena-mobile-backdrop"></div>
	
	<div id="maincontent">
		<!-- 悬浮侧边栏 -->
		<aside class="main-left">
			<div class="sidebar-brand">
				<img src="{{ media }}/img/logo.svg" alt="Athena Logo">
				<div class="title">{{ hostname }}</div>
			</div>

			<ul class="sidebar-menu">
				{%
					function render_menu(category, level) {
						let entries = menu.get_menu_children(category);
						if (!entries || !length(entries)) return;

						for (let entry in entries) {
							let has_children = length(menu.get_menu_children(entry.name)) > 0;
							let is_active = (node?.name == entry.name || index(node?.name ?? '', entry.name) == 0);
				%}
					<li class="{{ is_active ? 'active' : '' }}">
						<a href="{{ entry.url }}" class="{{ is_active ? 'active' : '' }}">
							<span>{{ entry.title }}</span>
						</a>
						{% if (has_children && is_active): %}
							<ul class="sub-menu">
								{% render_menu(entry.name, level + 1); %}
							</ul>
						{% endif %}
					</li>
				{%
						}
					}
					render_menu('', 0);
				%}
			</ul>
		</aside>

		<!-- 主内容右侧区 -->
		<div class="main-right">
			<header class="athena-header">
				<div class="header-left">
					<button id="athena-menu-btn" class="athena-icon-btn mobile-only" title="菜单">
						☰
					</button>
					<div class="brand-badge">
						雅典娜 AX6600 · 三频满血加速
					</div>
				</div>

				<div class="header-right">
					<button id="athena-theme-btn" class="athena-icon-btn" title="明暗模式切换">
						<span id="athena-theme-icon">🌙</span>
					</button>
					{% if (dispatcher.authenticated): %}
					<a href="{{ dispatcher.build_url('admin/logout') }}" class="athena-icon-btn" title="退出登录">
						🚪
					</a>
					{% endif %}
				</div>
			</header>

			<main class="container">
