{%
	const boardinfo = ubus.call("system", "board") ?? {};
	const hostname = striptags(boardinfo?.hostname ?? 'ImmortalWrt');

	http.prepare_content('text/html; charset=UTF-8');
-%}
<!DOCTYPE html>
<html lang="{{ dispatcher.lang }}" data-theme="light">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>{{ hostname }}{{ node?.title ? ` - ${striptags(node.title)}` : '' }} - LuCI</title>
	<meta name="theme-color" content="#1E88E5">
	<link rel="stylesheet" href="{{ media }}/css/cascade.css">
	<link rel="stylesheet" href="{{ media }}/css/dark.css">
	<link rel="stylesheet" href="{{ media }}/css/mobile.css">
	<link rel="shortcut icon" href="{{ media }}/img/logo.svg" type="image/svg+xml">
	{% if (node?.css): %}
	<link rel="stylesheet" href="{{ resource }}/{{ node.css }}">
	{% endif %}
	{% if (css): %}
	<style title="text/css">{{ css }}</style>
	{% endif %}
	<script src="{{ dispatcher.build_url('admin/translations', dispatcher.lang) }}"></script>
	<script src="{{ resource }}/cbi.js"></script>
	<script src="{{ resource }}/luci.js"></script>
	<script src="{{ media }}/js/theme.js"></script>
</head>
<body class="lang_{{ dispatcher.lang }} {{ node?.title ? ` - ${striptags(node.title)}` : '' }} {% if (ctx.authsession): %}logged-in{% endif %}" data-page="{{ entityencode(join('-', ctx.request_path ?? []), true) }}">
{% if (!blank_page): %}
	<div class="main">
		<div class="main-left" id="mainmenu" style="display:none">
			<div class="sidenav-header">
				<a class="brand" href="#">
					<img src="{{ media }}/img/logo.svg" alt="Athena Logo">
					<span class="brand-text">{{ hostname }}</span>
				</a>
			</div>
		</div>

		<div class="main-right">
			<header class="athena-header">
				<div class="header-left">
					<a class="showSide">☰</a>
					<div class="brand-badge">{{ hostname }} · 系统在线</div>
				</div>
				<div class="header-right">
					<div class="status" id="indicators"></div>
					<button id="athena-theme-btn" class="athena-icon-btn" title="明暗模式切换">
						<span id="athena-theme-icon">🌙</span>
					</button>
					{% if (dispatcher.authenticated): %}
					<a href="{{ dispatcher.build_url('admin/logout') }}" class="athena-icon-btn" title="退出登录">
						🚪
					</a>
					{% endif %}
				</div>
			</header>

			<div class="darkMask"></div>

			<div id="maincontent">
				<div class="container">
					<div id="tabmenu" style="display:none"></div>
{% else %}
	<div class="athena-login-page">
{% endif %}
